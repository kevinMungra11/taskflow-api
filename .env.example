NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow
# Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1h

# Frontend URL used in password reset links
APP_URL=http://localhost:5173
# Transactional mail (only used when NODE_ENV=production)
MAIL_API_URL=https://api.postmarkly.dev/v1/send
MAIL_API_KEY=
MAIL_FROM="Taskflow <no-reply@taskflow.dev>"
